# $Id: local.rules,v 1.11 2004/07/23 20:15:44 bmc Exp $
# ----------------
# LOCAL RULES
# ----------------
# This file intentionally does not come with signatures.  Put your local
# additions here.

#ALERT PING
alert icmp any any -> $HOME_NET any (msg:"TEST ICMP Ping detecte"; sid:100001; rev:1; )

#ALERT NMAP
#msg -> texte qui apparaitdans kibana
#flags:S -> repère un scan
#detectuin_filter ... -> ne déclanche que si la même source envoie x paquets en y seconds
alert tcp any any -> $HOME_NET any (msg:"SCAN DE PORTS detecte - possible nmap"; flags:S; detection_filter:track by_src, count 5, seconds 5; sid:1000002; rev:1; )

#ALERT brute force ssh
alert tcp any any -> $HOME_NET 22 (msg:"SSH Brute-Force attaque"; threshold: type both, track by_src, count 3, seconds 60; classtype:misc-attack; sid:1000281; rev:2;)
